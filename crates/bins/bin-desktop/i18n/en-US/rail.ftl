## The primary and context rails. Noun names come from the shared navigation Messages.

## Group headings, upper-cased by the renderer.

desktop-rail-group-ledger = Ledger
desktop-rail-group-net-worth = Net worth
desktop-rail-group-plan = Plan

## Noun names that only the desktop has: placeholder surfaces until each gets its own map.

desktop-nav-documents = Documents
desktop-nav-notifications = Notifications
desktop-nav-cash = Cash
desktop-nav-inventory = Inventory
desktop-nav-loans = Loans
desktop-nav-credit-cards = Credit cards
desktop-nav-investments = Investments

## The "not yet built" placeholder view. `$name` is the noun's name.

desktop-placeholder-title = { $name }
desktop-placeholder-body = This part of the ledger is not built yet.

## The context rail. `$count` is the number of accounts and `$glyph` the leading plus sign.

desktop-context-active-count = { $count } active
desktop-context-new-account = { $glyph } new account
