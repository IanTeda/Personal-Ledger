{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ian/.local/share/mise/installs/pipx-graphifyy/0.9.73/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ian/.local/share/mise/installs/pipx-graphifyy/0.9.73/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "johnnyvizz/claude-kit"
      }
    }
  },
  "enabledPlugins": {
    "savvy-flow@claude-kit": true,
    "savvy-progress@claude-kit": true
  }
}
