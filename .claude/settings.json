{
  "env": {
    "GRAPHIFY_OUT": ".graphify-out",
    "MISE_OFFLINE": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ian/.local/share/mise/installs/pipx-graphifyy/0.9.73/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "/home/ian/.local/share/mise/installs/pipx-graphifyy/0.9.73/bin/graphify hook-guard search",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(rg *)",
            "command": "/home/ian/.local/share/mise/installs/pipx-graphifyy/0.9.73/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(crates/**)",
            "command": "/home/ian/.local/share/mise/installs/pipx-graphifyy/0.9.73/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "johnnyvizz/claude-kit"
      }
    }
  }
}
