  "cards": [
    { "dot": "cyan", "title": "How it flows", "items": ["The View binds declaratively to ViewModel properties and commands", "The binding engine copies values both ways and refreshes on change events", "The ViewModel shapes Model data for one screen and holds UI state (selection, validation)", "The ViewModel never references the View, so it is unit-testable"] },
    { "dot": "emerald", "title": "Where it is used", "items": ["WPF, WinUI, .NET MAUI, Avalonia (origin: Microsoft, 2005)", "Android Jetpack ViewModel, SwiftUI with ObservableObject", "Slint and Qt Quick (QML) property bindings"] },
    { "dot": "amber", "title": "Trade-offs", "items": ["+ Designers and developers work on View and logic apart", "+ Screen logic tested without rendering", "− Needs a binding engine; magic strings or codegen", "− Bindings can be hard to debug; overkill for simple screens"] },
    { "dot": "violet", "title": "In gpui terms", "items": ["No binding engine: a View Entity reads its ViewModel in render()", "ViewModel ≈ a per-screen Entity that observes domain store Entities", "Changes propagate by cx.notify() and cx.observe / cx.subscribe"] }
