    { "dot": "cyan", "title": "UI layer", "items": ["GPUI owns the App, Windows and Entities; per-OS crates implement its Platform trait", "Workspace lays out Panes, Docks and panels (project, git, terminal, agent)", "Editor renders a MultiBuffer through a DisplayMap (folds, wraps, inlays)"] },
